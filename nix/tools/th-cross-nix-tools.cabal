cabal-version: 3.0
name: th-cross-nix-tools
version: 0.1.0.0
license: BSD-3-Clause
build-type: Simple

common warnings
  ghc-options:
      -Wall

library th-cross-nix-tools-lib
  import: warnings
  exposed-modules:
      ThCross.NixTools.Cabal
  hs-source-dirs:
      src
  default-language: Haskell2010
  build-depends:
      base,
      bytestring,
      Cabal,
      directory,
      filepath

executable dump-cabal-source-dirs
  import: warnings
  main-is:
      Main.hs
  hs-source-dirs:
      app/dump-cabal-source-dirs
  default-language: Haskell2010
  build-depends:
      base,
      bytestring,
      Cabal,
      directory,
      filepath,
      th-cross-nix-tools-lib

executable dump-cabal-cpp-options
  import: warnings
  main-is:
      Main.hs
  hs-source-dirs:
      app/dump-cabal-cpp-options
  default-language: Haskell2010
  build-depends:
      base,
      bytestring,
      Cabal,
      directory,
      filepath,
      th-cross-nix-tools-lib

executable validate-cabal-component-context
  import: warnings
  main-is:
      Main.hs
  hs-source-dirs:
      app/validate-cabal-component-context
  default-language: Haskell2010
  build-depends:
      base,
      Cabal,
      directory,
      filepath
