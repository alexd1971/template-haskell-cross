cabal-version: 3.0
name: th-cross-nix-tools
version: 0.1.0.0
license: BSD-3-Clause
build-type: Simple

common warnings
  ghc-options:
      -Wall

library th-cross-nix-tools-lib
  import: warnings
  exposed-modules:
      ThCross.NixTools.Cabal
      ThCross.NixTools.PluginConfig
      ThCross.NixTools.Validate
  hs-source-dirs:
      src
  default-language: Haskell2010
  build-depends:
      base,
      bytestring,
      Cabal,
      directory,
      filepath,
      process

executable th-cross-nix-tool
  import: warnings
  main-is:
      Main.hs
  hs-source-dirs:
      app/th-cross-nix-tool
  default-language: Haskell2010
  build-depends:
      base,
      bytestring,
      Cabal,
      directory,
      filepath,
      th-cross-nix-tools-lib
