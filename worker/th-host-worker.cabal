cabal-version: 3.0
name: th-host-worker
version: 0.1.0.0
license: BSD-3-Clause
copyright: 2026 Alexey Danilevsky
build-type: Simple

executable th-host-worker
  main-is: Main.hs
  other-modules:
      Worker.Evaluate
    , Worker.Capture
    , Worker.SpliceCache
    , Worker.TH
  hs-source-dirs:
      app
  default-language: Haskell2010
  build-depends:
      base >= 4.20 && < 4.22
    , binary
    , bytestring
    , containers
    , directory
    , filepath
    , ghc >= 9.10 && < 9.11
    , ghc-boot >= 9.10 && < 9.11
    , ghci
    , process
    , template-haskell
    , th-cross-protocol
  ghc-options:
      -Wall
