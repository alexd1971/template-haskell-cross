cabal-version: 3.0
name: th-executable-consumer
version: 0.1.0.0
build-type: Simple

executable th-executable-consumer
  main-is:
      Main.hs
  hs-source-dirs:
      app
  default-language: Haskell2010
  build-depends:
      base >= 4.19 && < 4.22,
      microlens,
      microlens-th
  ghc-options:
      -Wall
