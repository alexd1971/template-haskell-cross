cabal-version: 3.0
name: th-executable-consumer
version: 0.1.0.0
license: BSD-3-Clause
build-type: Simple

library
  exposed-modules:
      ExecutableConsumer.Gen
  hs-source-dirs:
      src
  default-language: Haskell2010
  build-depends:
      base >= 4.19 && < 4.22,
      microlens-th,
      template-haskell
  ghc-options:
      -Wall

executable th-executable-consumer
  main-is:
      Main.hs
  hs-source-dirs:
      app
  default-language: Haskell2010
  build-depends:
      base >= 4.19 && < 4.22,
      microlens,
      th-executable-consumer
  ghc-options:
      -Wall
