cabal-version: 3.0
name: th-cross-plugin
version: 0.1.0.0
license: BSD-3-Clause
build-type: Simple

library
  exposed-modules:
      THCross.Plugin
      THCross.ParseFragment
      THCross.Protocol
      THCross.SpliceKey
  hs-source-dirs:
      src
  default-language: Haskell2010
  build-depends:
      base >= 4.19 && < 4.22
    , binary
    , bytestring
    , ghc >= 9.8 && < 9.11
    , ghc-boot >= 9.8 && < 9.11
    , ghci
    , process
    , template-haskell
  ghc-options:
      -Wall

test-suite integration
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
      Integration.Cases
      Integration.Harness
  hs-source-dirs:
      test
  default-language: Haskell2010
  build-depends:
      base >= 4.19 && < 4.22
    , directory
    , filepath
    , process
    , tasty
    , tasty-hunit
  ghc-options:
      -Wall

test-suite raw-th
  type: exitcode-stdio-1.0
  main-is: RawTHMain.hs
  other-modules:
      Integration.Harness
      Integration.RawTH
  hs-source-dirs:
      test
  default-language: Haskell2010
  build-depends:
      base >= 4.19 && < 4.22
    , directory
    , filepath
    , process
    , tasty
    , tasty-hunit
  ghc-options:
      -Wall
