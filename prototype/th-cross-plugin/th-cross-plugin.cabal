cabal-version: 3.0
name: th-cross-plugin
version: 0.1.0.0
build-type: Simple

library
  exposed-modules:
      THCross.Plugin
      THCross.ParseFragment
      THCross.Protocol
      THCross.SpliceKey
  hs-source-dirs:
      src
  default-language: Haskell2010
  build-depends:
      aeson
    , base >= 4.19 && < 4.20
    , bytestring
    , ghc == 9.8.4
    , process
  ghc-options:
      -Wall

test-suite integration
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
      Integration.Cases
      Integration.Harness
  hs-source-dirs:
      test
  default-language: Haskell2010
  build-depends:
      base >= 4.19 && < 4.20
    , directory
    , filepath
    , process
    , tasty
    , tasty-hunit
  ghc-options:
      -Wall
