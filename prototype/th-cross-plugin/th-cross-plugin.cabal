cabal-version: 3.0
name: th-cross-plugin
version: 0.1.0.0
build-type: Simple

library
  exposed-modules:
      THCross.Plugin
      THCross.ParseFragment
      THCross.Protocol
  hs-source-dirs:
      src
  default-language: Haskell2010
  build-depends:
      aeson
    , base >= 4.19 && < 4.20
    , bytestring
    , ghc == 9.8.4
    , process
  ghc-options:
      -Wall
