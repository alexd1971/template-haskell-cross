cabal-version: 3.0
name: th-host-worker
version: 0.1.0.0
build-type: Simple

executable th-host-worker
  main-is: Main.hs
  other-modules:
      Worker.Evaluate
  hs-source-dirs:
      app
  default-language: Haskell2010
  build-depends:
      base >= 4.19 && < 4.20
    , binary
    , bytestring
    , containers
    , directory
    , filepath
    , ghc == 9.8.4
    , ghc-boot == 9.8.4
    , ghci
    , process
    , th-cross-plugin
  ghc-options:
      -Wall
