cabal-version: 3.0
name: th-aeson-consumer
version: 0.1.0.0
license: BSD-3-Clause
build-type: Simple

library
  exposed-modules:
      AesonConsumer
  other-modules:
      AesonConsumer.Api.Payload
      AesonConsumer.Domain.Address
      AesonConsumer.Domain.User
      AesonConsumer.JsonOptions
      AesonConsumer.TH
  hs-source-dirs:
      src
  default-language: Haskell2010
  build-depends:
      aeson,
      base >= 4.19 && < 4.22,
      template-haskell
  ghc-options:
      -Wall
