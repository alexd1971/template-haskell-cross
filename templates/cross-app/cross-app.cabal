cabal-version: 3.0
name: cross-app
version: 0.1.0.0
license: BSD-3-Clause
copyright: 2026 Alexey Danilevsky
build-type: Simple

library
  exposed-modules:
      App.Payload
  hs-source-dirs:
      src
  default-language: Haskell2010
  build-depends:
      aeson,
      base >= 4.19 && < 4.22,
      bytestring,
      template-haskell
  ghc-options:
      -Wall

executable cross-app
  main-is:
      Main.hs
  hs-source-dirs:
      app
  default-language: Haskell2010
  build-depends:
      aeson,
      base >= 4.19 && < 4.22,
      bytestring,
      cross-app
  ghc-options:
      -Wall
