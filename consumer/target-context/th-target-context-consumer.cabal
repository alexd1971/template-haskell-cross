cabal-version: 3.0
name: th-target-context-consumer
version: 0.1.0.0
license: BSD-3-Clause
build-type: Simple

library
  exposed-modules:
      Example
  other-modules:
      Gen
  hs-source-dirs:
      src
  default-language: Haskell2010
  cpp-options:
      -DTH_CONSUMER_TARGET_CONTEXT
  build-depends:
      base >= 4.19 && < 4.22,
      template-haskell
  ghc-options:
      -Wall
