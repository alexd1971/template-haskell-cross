cabal-version: 3.0
name: th-cross-protocol
version: 0.1.0.0
license: BSD-3-Clause
copyright: 2026 Alexey Danilevsky
build-type: Simple

library
  exposed-modules:
      THCross.Protocol
      THCross.SpliceKey
  hs-source-dirs:
      src
  default-language: Haskell2010
  build-depends:
      base >= 4.19 && < 4.22
    , binary
    , bytestring
    , ghc >= 9.8 && < 9.13
    , ghc-boot >= 9.8 && < 9.13
    , ghci
    , template-haskell
  ghc-options:
      -Wall
